{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "findings"]
    },
    "blockingFindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repairable": {
      "type": "boolean"
    },
    "blockerKind": {
      "type": "string",
      "enum": ["none", "code", "requirements", "infrastructure", "safety"]
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "blockingFindings",
    "repairable",
    "blockerKind",
    "summary"
  ],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } } },
      "then": {
        "properties": {
          "blockingFindings": { "maxItems": 0 },
          "repairable": { "const": false },
          "blockerKind": { "const": "none" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "findings" } } },
      "then": {
        "properties": {
          "blockingFindings": { "minItems": 1 },
          "blockerKind": {
            "enum": ["code", "requirements", "infrastructure", "safety"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "blockerKind": {
            "enum": ["requirements", "infrastructure", "safety"]
          }
        }
      },
      "then": { "properties": { "repairable": { "const": false } } }
    }
  ],
  "additionalProperties": false
}
