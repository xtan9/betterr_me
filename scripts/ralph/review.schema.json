{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "findings"]
    },
    "blockingFindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repairable": {
      "type": "boolean"
    },
    "blockerKind": {
      "type": "string",
      "enum": [
        "none",
        "code",
        "requirements",
        "infrastructure",
        "ticket-infrastructure",
        "security",
        "safety"
      ]
    },
    "evidenceReviewed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "blockingFindings",
    "repairable",
    "blockerKind",
    "evidenceReviewed",
    "summary"
  ],
  "additionalProperties": false
}
